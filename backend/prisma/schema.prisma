// ==========================================================
// Provisional License Online Exam Platform — Prisma Schema
// Stack: Nest.js (API) + Next.js (client) + Prisma ORM
// ==========================================================

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

// -----------------------------
// ENUMS
// -----------------------------

enum QuestionType {
  TEXT
  TEXT_IMAGE
}

enum TransactionType {
  TOPUP
  EXAM_FEE          // legacy: exams no longer debit the wallet (access comes from subscriptions)
  REFUND
  PLAN_PURCHASE
  ADMIN_ADJUSTMENT
}

enum PlanAccessType {
  ATTEMPTS  // fixed number of exam attempts, never expires
  TIME      // unlimited attempts for durationDays
}

enum UserSubscriptionStatus {
  PENDING    // awaiting payment confirmation — never grants access
  ACTIVE     // stored status only; time-plan activity is always decided from startsAt/expiresAt
  EXHAUSTED  // attempt bundle with no attempts left
  EXPIRED
  CANCELLED  // revoked by an admin — never grants access
}

enum UserSubscriptionSource {
  PURCHASE
  ADMIN_GRANT
  MIGRATION
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum ExamAttemptStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

// -----------------------------
// USER & WALLET
// -----------------------------

model User {
  id               String   @id @default(uuid())
  fullName         String
  email            String?   @unique
  phone            String   @unique // login key — findByPhone must resolve to exactly one user
  passwordHash     String
  // Deactivated users can't log in, and an existing token stops working on the next request
  // (JwtStrategy + CaslAbilityFactory both check it). There is no user deletion.
  isActive         Boolean  @default(true)
  userRoles        UserRole[]

  walletBalance    Decimal  @default(0) @db.Decimal(10, 2)
  hasUsedFreeExam  Boolean  @default(false)

  transactions     Transaction[]
  examAttempts     ExamAttempt[]
  subscriptions    UserSubscription[]

  // Audit back-relations: admin-performed wallet adjustments and subscription grants/changes.
  performedTransactions  Transaction[]       @relation("TransactionPerformedBy")
  grantedSubscriptions   UserSubscription[]  @relation("SubscriptionGrantedBy")

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("users")
}

// -----------------------------
// RBAC (dynamic, DB-driven — pure role -> permission model)
// -----------------------------

model Role {
  id            String   @id @default(uuid())
  name          String   @unique
  description   String?
  isSuperAdmin  Boolean  @default(false)
  guardName     String?

  rolePermissions RolePermission[]
  userRoles       UserRole[]
  defaultRole     DefaultRole?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("roles")
}

// Singleton row: id is pinned to 1, so a second row can never be inserted —
// the primary key itself is the uniqueness guarantee. No partial index needed.
model DefaultRole {
  id     Int    @id @default(1)
  roleId String @unique
  role   Role   @relation(fields: [roleId], references: [id])

  @@map("default_role")
}

model Permission {
  id          String   @id @default(uuid())
  // Stable key from src/access/access.config.ts (e.g. "categories.create"). The config is the
  // single source of truth: PermissionSyncService creates/backfills rows to match it on
  // startup. Null only for legacy rows that match no config entry — those stay enforced for
  // roles that already hold them but can't be newly assigned.
  name        String?  @unique
  action      String   // e.g. "create", "read", "update", "delete", "manage"
  subject     String   // e.g. "Question", "ExamAttempt", "Transaction", "all"
  conditions  Json?    // CASL-style conditions, e.g. { "userId": "${user.id}" }
  fields      Json?    // MySQL has no native array type — store as a JSON array of strings
  description String?

  rolePermissions RolePermission[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // No DB-level unique constraint on (action, subject): legitimate rows
  // intentionally share an action+subject with different `conditions`
  // (e.g. unconditioned "update ExamAttempt" for admins alongside
  // owner-scoped "update ExamAttempt" for clients). Json columns can't be
  // part of a unique index on MySQL via Prisma anyway, so exact-duplicate
  // detection (same action + subject + deep-equal conditions) is enforced
  // in PermissionsService before insert, not by the database.
  @@index([action, subject])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId       String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId String

  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId    String

  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Transaction {
  id            String             @id @default(uuid())
  user          User               @relation(fields: [userId], references: [id])
  userId        String

  type          TransactionType
  status        TransactionStatus  @default(PENDING)
  amount        Decimal            @db.Decimal(10, 2)
  isReversed    Boolean            @default(false)

  provider      String?            // e.g. MTN_MOMO, CARD, AIRTEL_MONEY
  providerRef   String?            // gateway transaction reference

  examAttempt   ExamAttempt?       // if this transaction paid for an exam (legacy EXAM_FEE)
  userSubscription UserSubscription? // if this transaction paid for a plan (PLAN_PURCHASE)

  // ADMIN_ADJUSTMENT / REFUND audit: who made the change and why.
  performedBy   User?              @relation("TransactionPerformedBy", fields: [performedById], references: [id])
  performedById String?
  note          String?            @db.Text

  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([userId])
  @@map("transactions")
}

// -----------------------------
// SUBSCRIPTIONS (one-time prepaid plans — never auto-renewing)
// -----------------------------

// The catalog, fully admin-managed (no seed). Money is whole RWF (Int), unlike the legacy
// Decimal wallet columns. Translatable text is stored as JSON keyed by locale — see
// src/subscription-plans/plan-locales.ts for the supported set and the fallback rule.
model SubscriptionPlan {
  id             String          @id @default(uuid())
  name           Json            // { "en": "Starter", "rw": "...", "fr": "..." } — "en" required
  extraFeatures  Json?           // { "en": ["..."], "rw": ["..."] } — admin-entered extra lines
  price          Int
  currency       String          @default("RWF") @db.VarChar(3)
  accessType     PlanAccessType
  attemptLimit   Int?            // ATTEMPTS only
  durationDays   Int?            // TIME only
  isActive       Boolean         @default(true)
  isMostPopular  Boolean         @default(false) // at most one — enforced in SubscriptionPlansService
  displayOrder   Int             @default(0)

  subscriptions  UserSubscription[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([isActive, displayOrder])
  @@map("subscription_plans")
}

// One row per purchase/grant. Everything that matters for access is snapshotted at purchase
// time, so editing a plan never changes an existing subscription.
model UserSubscription {
  id                 String                  @id @default(uuid())
  user               User                    @relation(fields: [userId], references: [id])
  userId             String

  // Null for ADMIN_GRANT/MIGRATION rows that don't come from a catalog plan. Restrict: a plan
  // with purchases can only be deactivated, never deleted.
  plan               SubscriptionPlan?       @relation(fields: [planId], references: [id], onDelete: Restrict)
  planId             String?

  // Snapshot
  planName           Json
  price              Int
  currency           String                  @default("RWF") @db.VarChar(3)
  accessType         PlanAccessType
  attemptLimit       Int?
  durationDays       Int?

  attemptsRemaining  Int?                    // ATTEMPTS only — decremented with a conditional update
  status             UserSubscriptionStatus  @default(ACTIVE)
  source             UserSubscriptionSource  @default(PURCHASE)
  startsAt           DateTime                // UTC; queued time plans start in the future
  expiresAt          DateTime?               // UTC; always null for ATTEMPTS

  transaction        Transaction?            @relation(fields: [transactionId], references: [id])
  transactionId      String?                 @unique

  grantedBy          User?                   @relation("SubscriptionGrantedBy", fields: [grantedById], references: [id])
  grantedById        String?
  note               String?                 @db.Text

  examAttempts       ExamAttempt[]

  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([userId, accessType, startsAt, expiresAt]) // "is a time plan active right now?"
  @@index([userId, accessType, attemptsRemaining])   // "oldest bundle with attempts left"
  @@index([planId])
  @@map("user_subscriptions")
}

// -----------------------------
// QUESTION BANK
// -----------------------------

model Category {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?

  questions    Question[]
  examAttempts ExamAttempt[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("categories")
}

model Question {
  id            String        @id @default(uuid())
  category      Category      @relation(fields: [categoryId], references: [id])
  categoryId    String

  type          QuestionType  @default(TEXT)
  text          String        @db.Text // unannotated String maps to VARCHAR(191) on MySQL —
                                        // too short for a real question sentence; MySQL silently
                                        // truncates instead of erroring unless strict SQL mode is on
  imageUrl      String?       // populated when type = TEXT_IMAGE
  explanation   String?       @db.Text // shown when client reviews answers

  isActive      Boolean       @default(true)
  allowMultiple Boolean      @default(false)
  // Soft delete for questions referenced by past attempts (those can't be hard-deleted without
  // breaking attempt history). Deleted questions are hidden from admin lists and exam draws.
  deletedAt     DateTime?

  options       Option[]
  attemptLinks  ExamAttemptQuestion[]
  answers       ExamAttemptAnswer[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([categoryId])
  @@map("questions")
}

model Option {
  id           String     @id @default(uuid())
  question     Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId   String

  text         String?    @db.Text // see Question.text above — same VARCHAR(191) truncation risk
  imageUrl     String?
  isCorrect    Boolean    @default(false) // correctness lives on the option row, so reordering can't change it
  // Display order within the question (0-based). Labels A/B/C/D are derived from this at render
  // time and never stored.
  position     Int        @default(0)

  selectedIn   ExamAttemptAnswerOption[]

  @@index([questionId, position])
  @@map("options")
}

// -----------------------------
// EXAM CONFIG
// -----------------------------

model ExamConfig {
  id                 String   @id @default(uuid())
  name               String   @default("Standard Provisional Exam")
  numberOfQuestions  Int      @default(20)
  price              Decimal  @default(0) @db.Decimal(10, 2)
  passMarkPercent    Int      @default(60)
  durationMinutes    Int      @default(20)
  isActive           Boolean  @default(true)

  examAttempts       ExamAttempt[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("exam_configs")
}

// -----------------------------
// EXAM ATTEMPTS (results live here)
// -----------------------------

model ExamAttempt {
  id              String              @id @default(uuid())
  user            User                @relation(fields: [userId], references: [id])
  userId          String

  examConfig      ExamConfig          @relation(fields: [examConfigId], references: [id])
  examConfigId    String

  // When set, the exam draws only from this category's questions (e.g. a client drilling
  // "Traffic Signs"). When null, questions are balanced across every active category.
  category        Category?           @relation(fields: [categoryId], references: [id])
  categoryId      String?

  transaction     Transaction?        @relation(fields: [transactionId], references: [id])
  transactionId   String?             @unique

  // The subscription that authorized this attempt (null for the free first exam and for
  // attempts made before subscriptions existed).
  userSubscription   UserSubscription? @relation(fields: [userSubscriptionId], references: [id])
  userSubscriptionId String?

  isFree          Boolean             @default(false)
  status          ExamAttemptStatus   @default(IN_PROGRESS)

  totalQuestions  Int
  score           Int                 @default(0)
  percentage      Decimal             @default(0) @db.Decimal(5, 2)
  passed          Boolean             @default(false)

  questions       ExamAttemptQuestion[]
  answers         ExamAttemptAnswer[]

  startedAt       DateTime            @default(now())
  completedAt     DateTime?

  @@index([userId])
  @@index([userSubscriptionId])
  @@map("exam_attempts")
}

// Snapshot of which questions (and in what order) made up this attempt
model ExamAttemptQuestion {
  id             String       @id @default(uuid())
  examAttempt    ExamAttempt  @relation(fields: [examAttemptId], references: [id], onDelete: Cascade)
  examAttemptId  String

  question       Question     @relation(fields: [questionId], references: [id])
  questionId     String

  order          Int          // 1..20 display order

  @@unique([examAttemptId, questionId])
  @@index([examAttemptId])
  @@map("exam_attempt_questions")
}

// The client's selected answer per question, per attempt
model ExamAttemptAnswer {
  id                String                     @id @default(uuid())
  examAttempt       ExamAttempt                @relation(fields: [examAttemptId], references: [id], onDelete: Cascade)
  examAttemptId     String

  question          Question                   @relation(fields: [questionId], references: [id])
  questionId        String

  selectedOptions   ExamAttemptAnswerOption[]   // CHANGED — replaces selectedOption/selectedOptionId

  isCorrect         Boolean                    @default(false)
  answeredAt        DateTime                   @default(now())

  @@unique([examAttemptId, questionId])
  @@index([examAttemptId])
  @@map("exam_attempt_answers")
}

model ExamAttemptAnswerOption {
  id         String             @id @default(uuid())
  answer     ExamAttemptAnswer  @relation(fields: [answerId], references: [id], onDelete: Cascade)
  answerId   String

  option     Option             @relation(fields: [optionId], references: [id])
  optionId   String

  @@unique([answerId, optionId])
  @@index([optionId])
  @@map("exam_attempt_answer_options")
}
